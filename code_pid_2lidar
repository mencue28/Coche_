// =====================================================================
//  COCHE_LAB - SCADA web + 2 lidar + control de distancia a la pared
//
//  Geometría (ejes del coche: x = largo hacia el capó, y = ancho hacia la pared)
//    - Lidar TRASERO   : pines RX16/TX17  -> d_tra
//    - Lidar DELANTERO : pines RX19/TX4   -> d_del  (junto a las ruedas que giran)
//    - Separación entre ambos: S_CM = 26 cm
//
//    psi    = atan( (d_tra - d_del) / S )     (>0: el morro apunta hacia la pared)
//    d_perp = (d_del + d_tra)/2 * cos(psi)    (distancia perpendicular desde los sensores)
//
//  Control (modo automático), delta = ángulo de ruedas, >0 = girar hacia la pared:
//    delta = Kp*e + Ki*Integral(e) - Kpsi*psi        con e = d_perp - ref
//  Si el coche gira al revés de lo esperado: casilla "invertir signo".
//
//  Uso: WiFi "COCHE_LAB" (clave coche1234) y abrir http://192.168.4.1
//  Requiere core ESP32 de Arduino 3.x (ledcAttach(pin, freq, bits)).
// =====================================================================
#include <Arduino.h>
#include <WiFi.h>
#include <WebServer.h>
#include <math.h>

// ---------------- WiFi ----------------
const char* AP_SSID = "COCHE_LAB";
const char* AP_PASS = "coche1234";          // mínimo 8 caracteres

// ---------------- Pines ----------------
const int servoPin = 18;
const int PIN_RPWM = 25;
const int PIN_LPWM = 23;
// Enables del IBT-2: la FireBeetle ESP32 NO tiene GPIO32 ni GPIO33.
// R_EN y L_EN deben ir cableados al VCC del IBT-2 (siempre habilitados) y aquí = -1.
const int PIN_R_EN = -1;
const int PIN_L_EN = -1;
// Lidar TF
const int LIDAR_TRAS_RX = 16, LIDAR_TRAS_TX = 17;   // trasero  (UART1)
const int LIDAR_DEL_RX  = 19, LIDAR_DEL_TX  = 4;    // delantero (UART2)

// ---------------- Servo ----------------
const int frecuencia = 50;
const int resolucion = 10;
const int duty_mas45 = 55;
const int duty_centro = 76;
const int duty_menos45 = 95;

// ---------------- Motor ----------------
const uint32_t PWM_FREQ = 20000;            // Hz
const uint8_t  PWM_BITS = 10;
const uint32_t PWM_MAX  = (1u << PWM_BITS) - 1;

// ---------------- Seguridad / tiempos ----------------
const uint32_t TIMEOUT_MS    = 500;         // sin órdenes -> parar
const uint32_t LIDAR_TOUT_MS = 300;         // lidar sin datos nuevos -> no válido
const float RAMPA_PCT_S      = 150.0f;      // aceleración máx. (% por segundo)
const uint32_t TS_MS         = 20;          // periodo del lazo de actuación
const uint32_t TS_PID_MS     = 100;         // periodo del control (Ts = 0.1 s)

// ---------------- Geometría ----------------
const float S_CM = 26.0f;                   // separación entre lidar (cm)

// ---------------- Lidar ----------------
struct Lidar {
  HardwareSerial* s;
  uint8_t  buf[9];
  uint8_t  idx;
  uint16_t cm;                              // última distancia válida (cm)
  uint32_t t;                               // instante de la última trama válida
};
HardwareSerial SerialTras(1);
HardwareSerial SerialDel(2);
Lidar lidarTras = { &SerialTras, {0}, 0, 0, 0 };
Lidar lidarDel  = { &SerialDel,  {0}, 0, 0, 0 };

// Medidas derivadas
bool  sens_ok = false;
float d_del = 0, d_tra = 0, psi_deg = 0, d_perp = 0;

// ---------------- Controlador ----------------
float ref_cm = 100.0f;                      // referencia de d_perp: 1 m
float Kp = 0.5f;                            // °/cm
float Ki = 0.0f;                            // °/(cm·s)
float Kpsi = 0.5f;                          // °/°
const float Ts = 0.1f;
bool  invertir = false;
const float SERVO_MAX = 45.0f, SERVO_MIN = -45.0f;
float uI = 0.0f;                            // estado integral (grados)

// ---------------- Estado del mando ----------------
WebServer server(80);
volatile int consigna_v = 0;                // -100..100 %
volatile int consigna_a = 0;                // -45..45 grados (manual)
bool modo_auto = false;
float v_actual = 0.0f;
float servo_ang = 0.0f;                     // ángulo aplicado (grados)
bool auto_prev = false;
uint32_t t_ultimo_cmd = 0;
uint32_t t_ultimo_ts  = 0;
uint32_t t_pid        = 0;


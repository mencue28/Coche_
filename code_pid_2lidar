// ---------------- Lidar: lectura no bloqueante ----------------
// Trama TF: 0x59 0x59 DistL DistH StrL StrH Temp.. Checksum (9 bytes)
void leerLidar(Lidar &L) {
  while (L.s->available()) {
    uint8_t dato = L.s->read();

    if (L.idx == 0 && dato != 0x59) continue;
    if (L.idx == 1 && dato != 0x59) { L.idx = 0; continue; }

    L.buf[L.idx++] = dato;

    if (L.idx >= 9) {
      L.idx = 0;
      uint8_t checksum = 0;
      for (int i = 0; i < 8; i++) checksum += L.buf[i];
      if (checksum == L.buf[8]) {
        L.cm = L.buf[2] | (L.buf[3] << 8);
        L.t = millis();
      }
    }
  }
}

bool lidarValido(const Lidar &L, uint32_t ahora) {
  return ((ahora - L.t) <= LIDAR_TOUT_MS) && L.cm > 0 && L.cm < 1200;
}

// Calcula psi y d_perp a partir de los dos lidar
void calcularGeometria(uint32_t ahora) {
  sens_ok = lidarValido(lidarDel, ahora) && lidarValido(lidarTras, ahora);
  if (!sens_ok) return;
  d_del = lidarDel.cm;
  d_tra = lidarTras.cm;
  float psi = atan2f(d_tra - d_del, S_CM);          // rad, >0: morro hacia la pared
  psi_deg = psi * 180.0f / (float)M_PI;
  d_perp = 0.5f * (d_del + d_tra) * cosf(psi);
}

// ---------------- Servo ----------------
void moverDireccion(long angulo_deseado) {
  int duty_value;
  if (angulo_deseado < -45) angulo_deseado = -45;
  if (angulo_deseado >  45) angulo_deseado =  45;

  if (angulo_deseado < 0) {
    duty_value = map(angulo_deseado, -45, 0, duty_menos45, duty_centro);
  } else {
    duty_value = map(angulo_deseado, 0, 45, duty_centro, duty_mas45);
  }
  ledcWrite(servoPin, duty_value);
}

// ---------------- Control: PI sobre d_perp + realimentación de psi ----------------
// delta = Kp*e + uI - Kpsi*psi ;  uI' = Ki*e   (con anti-windup por saturación)
void controlPared() {
  float e = d_perp - ref_cm;
  float p = Kp * e - Kpsi * psi_deg;

  // Integral con anti-windup (no integra si está saturado en el mismo sentido)
  float u_try = p + uI;
  bool sat_alta = (u_try >= SERVO_MAX) && (Ki * e > 0);
  bool sat_baja = (u_try <= SERVO_MIN) && (Ki * e < 0);
  if (!sat_alta && !sat_baja) uI += Ki * e * Ts;
  if (uI > SERVO_MAX) uI = SERVO_MAX;
  if (uI < SERVO_MIN) uI = SERVO_MIN;

  float delta = p + uI;
  if (delta > SERVO_MAX) delta = SERVO_MAX;
  if (delta < SERVO_MIN) delta = SERVO_MIN;

  servo_ang = invertir ? -delta : delta;
}

// ---------------- Motor ----------------
void motorInit() {
  if (PIN_R_EN >= 0) { pinMode(PIN_R_EN, OUTPUT); digitalWrite(PIN_R_EN, LOW); }
  if (PIN_L_EN >= 0) { pinMode(PIN_L_EN, OUTPUT); digitalWrite(PIN_L_EN, LOW); }
  ledcAttach(PIN_RPWM, PWM_FREQ, PWM_BITS);
  ledcAttach(PIN_LPWM, PWM_FREQ, PWM_BITS);
  ledcWrite(PIN_RPWM, 0);
  ledcWrite(PIN_LPWM, 0);
}

// v en % con signo: >0 RPWM, <0 LPWM
void motorAplicar(float v) {
  float D = fabsf(v) / 100.0f;
  if (D > 1.0f) D = 1.0f;
  uint32_t duty = (uint32_t)lroundf(D * PWM_MAX);

  bool activo = duty > 0;
  if (PIN_R_EN >= 0) digitalWrite(PIN_R_EN, activo ? HIGH : LOW);
  if (PIN_L_EN >= 0) digitalWrite(PIN_L_EN, activo ? HIGH : LOW);

  ledcWrite(PIN_RPWM, v > 0 ? duty : 0);
  ledcWrite(PIN_LPWM, v < 0 ? duty : 0);
}

// ---------------- Servidor ----------------
void handleRoot() { server.send_P(200, "text/html", PAGINA); }

void handleCmd() {
  if (server.hasArg("v"))    consigna_v = constrain(server.arg("v").toInt(), -100, 100);
  if (server.hasArg("a"))    consigna_a = constrain(server.arg("a").toInt(), -45, 45);
  if (server.hasArg("m"))    modo_auto  = (server.arg("m").toInt() == 1);
  if (server.hasArg("ref"))  ref_cm = constrain(server.arg("ref").toFloat(), 10.0f, 800.0f);
  if (server.hasArg("kp"))   Kp   = constrain(server.arg("kp").toFloat(),   0.0f, 10.0f);
  if (server.hasArg("ki"))   Ki   = constrain(server.arg("ki").toFloat(),   0.0f, 10.0f);
  if (server.hasArg("kpsi")) Kpsi = constrain(server.arg("kpsi").toFloat(), 0.0f, 10.0f);
  if (server.hasArg("inv"))  invertir = (server.arg("inv").toInt() == 1);
  t_ultimo_cmd = millis();

  char out[170];
  snprintf(out, sizeof(out),
           "{\"d1\":%.0f,\"d2\":%.0f,\"dp\":%.1f,\"psi\":%.1f,\"ok\":%d,\"ang\":%.1f,\"m\":%d}",
           d_del, d_tra, d_perp, psi_deg, sens_ok ? 1 : 0, servo_ang, modo_auto ? 1 : 0);
  server.send(200, "application/json", out);
}

void setup() {
  Serial.begin(115200);

  // Servo
  ledcAttach(servoPin, frecuencia, resolucion);
  moverDireccion(0);

  // Motor
  motorInit();

  // Lidar
  SerialTras.begin(115200, SERIAL_8N1, LIDAR_TRAS_RX, LIDAR_TRAS_TX);
  SerialDel.begin(115200, SERIAL_8N1, LIDAR_DEL_RX, LIDAR_DEL_TX);

  // WiFi (punto de acceso)
  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS, 1, 0, 2);   // canal 1, visible, máx. 2 clientes
  WiFi.setSleep(false);
  WiFi.setTxPower(WIFI_POWER_19_5dBm);
  Serial.print("SCADA en http://");
  Serial.println(WiFi.softAPIP());

  server.on("/", handleRoot);
  server.on("/cmd", handleCmd);
  server.begin();

  t_ultimo_cmd = millis();
}

void loop() {
  server.handleClient();
  leerLidar(lidarTras);                      // vaciar siempre los buffers
  leerLidar(lidarDel);

  uint32_t ahora = millis();
  if (ahora - t_ultimo_ts < TS_MS) return;
  float dt = (ahora - t_ultimo_ts) / 1000.0f;
  t_ultimo_ts = ahora;

  calcularGeometria(ahora);
  bool enlace = (ahora - t_ultimo_cmd) <= TIMEOUT_MS;

  // ----- Velocidad (siempre manual, con fail-safe y rampa) -----
  int v_obj = enlace ? consigna_v : 0;
  float paso = RAMPA_PCT_S * dt;
  if      (v_actual < v_obj - paso) v_actual += paso;
  else if (v_actual > v_obj + paso) v_actual -= paso;
  else                              v_actual  = v_obj;
  motorAplicar(v_actual);

  // ----- Dirección: manual o automática -----
  if (enlace && modo_auto) {
    if (!auto_prev) {                        // acaba de entrar en automático
      auto_prev = true;
      uI = 0.0f;
      t_pid = ahora;
    }
    // Si falta algún lidar se mantiene el último ángulo
    if (sens_ok && (ahora - t_pid) >= TS_PID_MS) {
      t_pid = ahora;
      controlPared();
    }
  } else {
    auto_prev = false;
    servo_ang = enlace ? (float)consigna_a : 0.0f;
  }
  moverDireccion((long)lroundf(servo_ang));
}

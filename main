// (En1 - En2) = +1 -> RPWM = D ; -1 -> LPWM = D ; 0 -> todo a 0
void aplicar(int en1, int en2, float D) { //Si no me equivoco es la que controla la velocidad
  D = constrain(D, 0.0f, 1.0f);
  uint32_t duty = (uint32_t)round(D * PWM_MAX);
  int s = en1 - en2;
  digitalWrite(PIN_R_EN, HIGH);
  digitalWrite(PIN_L_EN, HIGH);
  pwmWriteR(s > 0 ? duty : 0);
  pwmWriteL(s < 0 ? duty : 0);
}

void ControlPared(float distancia, float *er_1, float *er_2, float *servo_1){

  // Punto de op: 100cm, 75 servo.

  float servo;
  float servo_inc;
  const int servomax= 95;
  const int servomin= 55;
  float ref = 100;
  float er;

  float Kp = 0.3;
  float Kd = 0;
  float Ki = 0;
  float Ts = 0.1;

  float q0 = Kp + Ki * Ts + Kd/Ts;
  float q1 = -Kp -(2.0*Kd)/Ts;
  float q2 = Kd/Ts;

  er = distancia - ref;

  // Control

  servo_inc = q0 * er + q1 * (*er_1) + q2 * (*er_2);

  servo = servo_inc + (*servo_1);

  // Saturación

  if(servo > servomax)
    servo = servomax;
  if(servo < servomin)
    servo = servomin;

    moverDireccion(servo);

  // Variables incrementales
    *er_2 = *er_1;
    *er_1 = er;
    *servo_1 = servo;
}

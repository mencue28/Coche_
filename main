// Funciones desarrolladas

// Ultrasónico
int Distancia_Ultrasonico(int URTRIG, int URECHO){
  digitalWrite(URTRIG, LOW);
  delayMicroseconds(20);
  digitalWrite(URTRIG, HIGH);              
  unsigned long LowLevelTime = pulseIn(URECHO, LOW) ;
  unsigned long DistanceMeasured = 0;
  if (LowLevelTime >= 50000)
  {DistanceMeasured=0;}
  else
  {DistanceMeasured = (LowLevelTime + 64.893)/50.695 ;}
  return DistanceMeasured;
}
// Laser
void iniciarSensores() {
  SerialTF1.begin(115200, SERIAL_8N1, 16, 17);
  //SerialTF2.begin(115200, SERIAL_8N1, 9, 10); //A priori sin usar de momento
}
int leerDistancia(int pinRX, int pinTX) {
  HardwareSerial *sensor;

  if (pinRX == 16 && pinTX == 17) {
    sensor = &SerialTF1;
  } else if (pinRX == 25 && pinTX == 26) {
    sensor = &SerialTF2;
  } else {
    return -1;
  }

  static uint8_t buffer1[9], buffer2[9];
  static uint8_t indice1 = 0, indice2 = 0;

  uint8_t *buffer = (sensor == &SerialTF1) ? buffer1 : buffer2;
  uint8_t &indice = (sensor == &SerialTF1) ? indice1 : indice2;

  while (sensor->available()) {
    uint8_t dato = sensor->read();

    if (indice == 0 && dato != 0x59) continue;
    if (indice == 1 && dato != 0x59) {
      indice = 0;
      continue;
    }

    buffer[indice++] = dato;

    if (indice >= 9) {
      indice = 0;

      uint8_t checksum = 0;
      for (int i = 0; i < 8; i++) checksum += buffer[i];

      if (checksum == buffer[8]) {
        return buffer[2] | (buffer[3] << 8);
      }
    }
  }
  return -1;
}
// Servo
void moverDireccion(long angulo_deseado) {
  int duty_value;

  // Límite de seguridad mecánico
  if (angulo_deseado < -45) angulo_deseado = -45;
  if (angulo_deseado > 45) angulo_deseado = 45;

  // Cálculo del Duty Cycle asimétrico
  if (angulo_deseado < 0) {
    duty_value = map(angulo_deseado, -45, 0, duty_menos45, duty_centro);
  } else {
    duty_value = map(angulo_deseado, 0, 45, duty_centro, duty_mas45);
  }
  
  // Actuación del servo
  ledcWrite(servoPin, duty_value);
  

}

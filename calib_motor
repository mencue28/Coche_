// Experimento K_h - IBT-2 (BTS7960) + ESP32 - AUTOMÁTICO
// Vout = (En1 - En2) * Kh * D

// ---------- PINES ----------
const int PIN_RPWM = 25;
const int PIN_LPWM = 26;
const int PIN_R_EN = 27;
const int PIN_L_EN = 18;

// ---------- PARÁMETROS ----------
const uint32_t PWM_FREQ = 20000;   // Hz
const uint8_t  PWM_BITS = 10;
const uint32_t HOLD_S   = 5;       // segundos por punto
const uint32_t INICIO_S = 5;
const float D_INICIO = 0.0f, D_FIN = 1.0f, D_PASO = 0.1f;

const int N_CONF = 2;
const int CONF[N_CONF][2] = { {1, 0}, {0, 1} };   // (En1, En2)

const uint32_t PWM_MAX = (1u << PWM_BITS) - 1;

void pwmInit() {
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcAttach(PIN_RPWM, PWM_FREQ, PWM_BITS);
  ledcAttach(PIN_LPWM, PWM_FREQ, PWM_BITS);
#else
  ledcSetup(0, PWM_FREQ, PWM_BITS); ledcAttachPin(PIN_RPWM, 0);
  ledcSetup(1, PWM_FREQ, PWM_BITS); ledcAttachPin(PIN_LPWM, 1);
#endif
}

void pwmWriteR(uint32_t v) {
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcWrite(PIN_RPWM, v);
#else
  ledcWrite(0, v);
#endif
}
void pwmWriteL(uint32_t v) {
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcWrite(PIN_LPWM, v);
#else
  ledcWrite(1, v);
#endif
}

// (En1 - En2) = +1 -> RPWM = D ; -1 -> LPWM = D ; 0 -> todo a 0
void aplicar(int en1, int en2, float D) {
  D = constrain(D, 0.0f, 1.0f);
  uint32_t duty = (uint32_t)round(D * PWM_MAX);
  int s = en1 - en2;
  digitalWrite(PIN_R_EN, HIGH);
  digitalWrite(PIN_L_EN, HIGH);
  pwmWriteR(s > 0 ? duty : 0);
  pwmWriteL(s < 0 ? duty : 0);
}

void parar() {
  pwmWriteR(0); pwmWriteL(0);
  digitalWrite(PIN_R_EN, LOW);
  digitalWrite(PIN_L_EN, LOW);
}

void setup() {
  Serial.begin(115200);
  pinMode(PIN_R_EN, OUTPUT);
  pinMode(PIN_L_EN, OUTPUT);
  pwmInit();
  parar();
  delay(1000);

  Serial.println("\n=== EXPERIMENTO K_h IBT-2 (automatico) ===");
  Serial.printf("f_pwm=%lu Hz | %lu s por punto\n", (unsigned long)PWM_FREQ, (unsigned long)HOLD_S);
  for (int s = INICIO_S; s > 0; s--) {
    Serial.printf("Empieza en %d s...\n", s);
    delay(1000);
  }

  int punto = 0;
  Serial.println("\nN,En1,En2,D,Vout_medida(V)");
  for (int c = 0; c < N_CONF; c++) {
    int en1 = CONF[c][0], en2 = CONF[c][1];
    for (float d = D_INICIO; d <= D_FIN + 0.0001f; d += D_PASO) {
      punto++;
      aplicar(en1, en2, d);
      Serial.printf(">>> PUNTO %d | En1=%d En2=%d | D=%.2f  -> MIDE AHORA\n", punto, en1, en2, d);
      for (uint32_t t = HOLD_S; t > 0; t--) {
        Serial.printf("    %lu s\n", (unsigned long)t);
        delay(1000);
      }
      Serial.printf("%d,%d,%d,%.2f,\n", punto, en1, en2, d);
    }
    parar();
    delay(2000);
  }
  parar();
  Serial.println("\n=== FIN DEL EXPERIMENTO (salida a 0) ===");
}

void loop() {}
